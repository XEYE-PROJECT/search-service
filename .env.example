# Copia este fichero a .env. Ojo: `docker compose` TAMBIÉN lo lee (para interpolar),
# así que los valores solo-host no deben colarse en el contenedor — ver DOCKER_BACKEND_URL.

# --- Integración con el backend ------------------------------------------------
# URL base del backend Java de XEYE, vista al ejecutar este servicio EN EL HOST.
BACKEND_URL=http://localhost:8000
# La misma URL vista desde DENTRO del contenedor (docker compose usa esta, nunca
# BACKEND_URL — en un contenedor `localhost` es el propio contenedor). Por defecto
# http://xeye-java-backend:8000 (ambos en la xeye-network). Si el backend corre en el
# host, usa: DOCKER_BACKEND_URL=http://host.docker.internal:8000
#DOCKER_BACKEND_URL=http://xeye-java-backend:8000
# Secreto compartido backend<->search. Debe coincidir con SEARCH_INTERNAL_TOKEN del backend.
# Un valor en blanco rechaza TODAS las llamadas internas (fail closed).
INTERNAL_TOKEN=dev-internal-token
#BACKEND_TIMEOUT_SECONDS=30

# --- Embeddings -----------------------------------------------------------------
# Modelo de fallback para embeber queries cuando la lista aún no tiene modelo entrenado.
# Los modelos por lista llegan dinámicamente del backend (el del entrenamiento in_use).
EMBEDDING_MODEL_DEFAULT=paraphrase-multilingual-MiniLM-L12-v2
# Cuántos modelos sentence-transformers mantener cargados a la vez (LRU).
MODELS_MAX_LOADED=2

# --- Caché en RAM ---------------------------------------------------------------
# Tope para todos los datos de listas cacheados (embeddings + FAISS + textos), con expulsión LRU.
CACHE_MAX_BYTES=1073741824
# Hasta este tamaño se puntúa con coseno exacto; por encima, FAISS HNSW.
EXACT_SEARCH_MAX_ELEMENTS=4096
#HNSW_M=32
#HNSW_EF_CONSTRUCTION=200
#HNSW_EF_SEARCH=96

# --- Puntuación -----------------------------------------------------------------
SEARCH_TEXT_WEIGHT=0.25
SEARCH_SEMANTIC_WEIGHT=0.75
SCORE_OVERRIDE_THRESHOLD=0.75

# --- API pública ----------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173
# Puerto del host publicado por docker compose (dentro siempre escucha en el 8002).
#SEARCH_SERVICE_PORT=8002

# --- Sincronización / logs ------------------------------------------------------
# Re-sync completo de api keys + metadatos de listas cada N segundos (0 lo desactiva).
REFRESH_INTERVAL_SECONDS=3600
# Throttle del re-sync extra que dispara una api key / nombre de lista desconocidos.
#REFRESH_MIN_INTERVAL_SECONDS=30
LOG_BATCH_MAX=50
LOG_FLUSH_SECONDS=2.0
#LOG_QUEUE_MAX=10000
#LOG_PUSH_RETRIES=3

LOG_LEVEL=INFO
# Nombre y versión anunciados en / y en el título de OpenAPI.
#SERVICE_NAME=xeye-search-service
#SERVICE_VERSION=2.0.0
