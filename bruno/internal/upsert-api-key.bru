meta {
  name: Upsert api key
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/v1/api-keys/{{apiKeyId}}
  body: json
  auth: none
}

headers {
  X-Internal-Token: {{internalToken}}
}

body:json {
  {
    "userId": {{userId}},
    "keyHash": "{{apiKeyHash}}"
  }
}

docs {
  Alta/actualización de una API key en el catálogo. El backend manda el SHA-256 hex de la
  key (`keyHash`), nunca el valor: `apiKeyHash` = `printf '%s' "$apiKey" | sha256sum`.
  Útil para registrar a mano la key que luego usarás en los endpoints públicos.
}
